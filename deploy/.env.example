# Public server. Copy to deploy/.env and replace every shop.example.com.
# Comments are whole lines. A value with a space goes in double quotes. Do not use $.
# Passwords: 12+ letters and digits.
# Secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"

SITE_ADDRESS=shop.example.com
ACME_EMAIL=you@example.com
ACME_PROFILE=classic

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_TRUST_X_FORWARDED_PROTO=1
DJANGO_RATELIMIT_ENABLE=1

DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=noname
DJANGO_DB_USER=noname
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

REDIS_PASSWORD=
WEB_WORKERS=2

DJANGO_SITE_URL=https://shop.example.com
DJANGO_DEFAULT_FROM_EMAIL="NoName <hello@shop.example.com>"
DJANGO_ORDER_EMAIL=you@example.com
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_NEWS_URL=

CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_FROM_POSTAL_CODE=
CDEK_TARIFF_CODE=136
