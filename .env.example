# Local development defaults. Use DJANGO_DEBUG=0 and real domains in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_RATELIMIT_ENABLE=1

# Telegram bot from @BotFather. Managers connect a private chat from the brand cabinet.
# TELEGRAM_NEWS_URL is the public buyers group link shown on the site.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_NEWS_URL=
