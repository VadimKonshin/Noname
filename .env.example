# Local development defaults. Use DJANGO_DEBUG=0 and real domains in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_TRUST_X_FORWARDED_PROTO=0
DJANGO_RATELIMIT_ENABLE=1

# SQLite stays the local database until these are set. Then: python manage.py migrate
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=noname
# DJANGO_DB_USER=noname
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# Empty cache URL keeps limits in this process. Redis shares them across workers.
# DJANGO_CACHE_URL=redis://127.0.0.1:6379/1

# CDEK calculator. Leave the id empty to keep the fixed tariff.
# Requests go to api.cdek.ru or api.edu.cdek.ru only. The test host is https://api.edu.cdek.ru/v2
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# CDEK_API_URL=https://api.cdek.ru/v2
# CDEK_FROM_POSTAL_CODE=
# CDEK_TARIFF_CODE=136
# CDEK_ITEM_WEIGHT_GRAMS=500

# Leave the host empty to print letters in the runserver console.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=NoName <hello@example.com>
# DJANGO_ORDER_EMAIL=hello@example.com
# DJANGO_SITE_URL=http://127.0.0.1:8000

# Telegram bot from @BotFather. Managers connect a private chat from the brand cabinet.
# TELEGRAM_NEWS_URL is the public buyers group: https://t.me/name or https://t.me/+invite
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_NEWS_URL=
